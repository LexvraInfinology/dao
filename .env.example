# Copy to .env and replace every replace_me value before starting the stack.
# Public NEXT_PUBLIC_* values are baked into the frontend image at build time.

NODE_ENV=production

# Host-published ports (PostgreSQL and Redis intentionally have no host ports)
WEB_PORT=3000
API_PORT=4000

# PostgreSQL (used by the Compose postgres service and Prisma)
POSTGRES_USER=replace_me_db_user
POSTGRES_PASSWORD=replace_me_db_password
POSTGRES_DB=equora_db
DATABASE_URL=postgresql://replace_me_db_user:replace_me_db_password@postgres:5432/equora_db?schema=public

# Redis (used by the Compose redis service; URL password must be URL-encoded)
REDIS_PASSWORD=replace_me_redis_password
REDIS_URL=redis://:replace_me_redis_password@redis:6379

# API security and browser access
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
SIWE_NONCE_TTL_SECONDS=300
CORS_ORIGIN=https://equorafidao.com,https://www.equorafidao.com,https://equorafi.com,https://www.equorafi.com,http://localhost:3000

# Blockchain RPC and indexer settings (TrobChain Mainnet: Chain ID 1000)
CHAIN_ID=1000
RPC_URL=https://fullnode-one.trobchain.com
FULLNODE_URL=https://fullnode-one.trobchain.com
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_START_BLOCK=0

# API/service tuning and external feeds
TROB_PRICE_API_URL=https://backend.trobchain.com/v1/market/price
PRICE_CACHE_TTL_MS=30000
DAO_SEAT_ENTRY_USD=300
CHAINLINK_BTT_USD_FEED=
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=3000
LOG_LEVEL=info
LOG_FORMAT=json

# Public frontend configuration (replace with the real deployment values)
NEXT_PUBLIC_APP_URL=https://equorafidao.com
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_MATRIX_DOMAIN=equorafi.com
NEXT_PUBLIC_DAO_DOMAIN=equorafidao.com
NEXT_PUBLIC_MATRIX_URL=https://equorafi.com
NEXT_PUBLIC_DAO_URL=https://equorafidao.com
NEXT_PUBLIC_CHAIN_ID=1000
NEXT_PUBLIC_TARGET_NETWORK=mainnet
NEXT_PUBLIC_RPC_URL=https://fullnode-one.trobchain.com
NEXT_PUBLIC_EXPLORER_URL=https://trobchain.com
NEXT_PUBLIC_EXPLORER_API_URL=https://backend.trobchain.com/v1
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=7663d51173c43f7ad40158edb7e88859

