# Copy to .env and replace every replace_me value before starting the stack.
# Public NEXT_PUBLIC_* values are baked into the frontend image at build time.

NODE_ENV=production

# Host-published ports (PostgreSQL and Redis intentionally have no host ports)
WEB_PORT=3000
API_PORT=4000

# PostgreSQL (used by the Compose postgres service and Prisma)
POSTGRES_USER=replace_me_db_user
POSTGRES_PASSWORD=replace_me_db_password
POSTGRES_DB=equora_db
DATABASE_URL=postgresql://replace_me_db_user:replace_me_db_password@postgres:5432/equora_db?schema=public

# Redis (used by the Compose redis service; URL password must be URL-encoded)
REDIS_PASSWORD=replace_me_redis_password
REDIS_URL=redis://:replace_me_redis_password@redis:6379

# API security and browser access
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
SIWE_NONCE_TTL_SECONDS=300
CORS_ORIGIN=http://localhost:3000

# Blockchain RPC and indexer settings
CHAIN_ID=31337
RPC_URL=https://replace_me_with_rpc_endpoint
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_START_BLOCK=0

# API/service tuning and external feeds
TROB_PRICE_API_URL=https://backend.trobchain.com/v1/market/price
PRICE_CACHE_TTL_MS=30000
DAO_SEAT_ENTRY_USD=300
CHAINLINK_BTT_USD_FEED=
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=3000
LOG_LEVEL=info
LOG_FORMAT=json

# Public frontend configuration (replace with the real deployment values)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MATRIX_DOMAIN=replace_me_matrix_domain
NEXT_PUBLIC_DAO_DOMAIN=replace_me_dao_domain
NEXT_PUBLIC_MATRIX_URL=https://replace_me_matrix_domain
NEXT_PUBLIC_DAO_URL=https://replace_me_dao_domain
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_TARGET_NETWORK=hardhat
NEXT_PUBLIC_EXPLORER_URL=https://testnet.trobchain.com
NEXT_PUBLIC_EXPLORER_API_URL=https://testnet-backend.trobchain.com/v1
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=replace_me_walletconnect_project_id

# Contract addresses; leave blank only when the indexer should remain idle.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_DAO_ADDRESS=
NEXT_PUBLIC_DAO_MEMBERSHIP_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_MATRIX_ADDRESS=
NEXT_PUBLIC_SALARY_POOL_ADDRESS=
NEXT_PUBLIC_MAGIC_BOX_ADDRESS=
NEXT_PUBLIC_REWARD_POOL_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=

# Optional frontend-hosted download override
TROBSAFE_APK_URL=
NEXT_PUBLIC_TROBSAFE_APK_URL=

# Deployer / Admin Private Key (Keep strictly secret; only needed for deployment)
DEPLOYER_PRIVATE_KEY=""
TREASURY_ADDRESS=""
BSCSCAN_API_KEY=""

# Community Verification & Social Channels
NEXT_PUBLIC_WHATSAPP_DAO_GROUP_URL="https://chat.whatsapp.com/GR19373Pgq7LezBKtXC0ng"

# TrobChain Testnet & Explorer Endpoints
FULLNODE_URL="https://fullnode-one-testnet.trobchain.com"
NEXT_PUBLIC_OFFICIAL_SR_TESTNET_ADDRESS="TJRjpQo1M8Ai8LQaVqX1o6kCFvgR2qJvV5"
NEXT_PUBLIC_OFFICIAL_SR_MAINNET_ADDRESS="TC7LCXJ5qhhw6ewLzK8SJuJiwtWmLExLYY"
