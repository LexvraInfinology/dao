# ==============================================================================
# EQUORA PROTOCOL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=equora_admin
POSTGRES_PASSWORD=equora_secret_password
POSTGRES_DB=equora_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma connection string (used by backend and indexer)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Cache, SIWE Nonce, BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=equora_redis_secret
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (SIWE / JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_equora_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=24h
SIWE_NONCE_TTL_SECONDS=300
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN & RPC NETWORKS
# ------------------------------------------------------------------------------
# Chain ID (31337 for Hardhat Local, 97 for BSC Testnet, 56 for BSC Mainnet)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Equora.Fi Protocol Contract Addresses (Auto-populated by pnpm deploy)
NEXT_PUBLIC_TOKEN_ADDRESS=""
NEXT_PUBLIC_REGISTRY_ADDRESS=""
NEXT_PUBLIC_NFT_ADDRESS=""
NEXT_PUBLIC_DAO_ADDRESS=""
NEXT_PUBLIC_DAO_MEMBERSHIP_ADDRESS=""
NEXT_PUBLIC_VAULT_ADDRESS=""
NEXT_PUBLIC_MATRIX_ADDRESS=""
NEXT_PUBLIC_SALARY_POOL_ADDRESS=""
NEXT_PUBLIC_MAGIC_BOX_ADDRESS=""
NEXT_PUBLIC_REWARD_POOL_ADDRESS=""
NEXT_PUBLIC_VESTING_ADDRESS=""

# ------------------------------------------------------------------------------
# 5. FRONTEND & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Production Domain Names
NEXT_PUBLIC_MATRIX_DOMAIN="equorafi.com"
NEXT_PUBLIC_DAO_DOMAIN="equorafidao.com"
NEXT_PUBLIC_MATRIX_URL="https://equorafi.com"
NEXT_PUBLIC_DAO_URL="https://equorafidao.com"

# Web3 Provider Settings
NEXT_PUBLIC_TARGET_NETWORK="hardhat"
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="7663d51173c43f7ad40158edb7e88859"

# ------------------------------------------------------------------------------
# 6. BACKGROUND SERVICES (Indexer & Queue Worker)
# ------------------------------------------------------------------------------
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_START_BLOCK=0
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=3000

# Deployer / Admin Private Key (Keep strictly secret; only needed for deployment)
DEPLOYER_PRIVATE_KEY=""
TREASURY_ADDRESS=""
BSCSCAN_API_KEY=""
