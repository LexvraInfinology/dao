# ==============================================================================
# EQUORA.FI BACKEND API (apps/api) — ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/equora_db?sslmode=require"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=24h
SIWE_NONCE_TTL_SECONDS=300

# Blockchain RPC
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
