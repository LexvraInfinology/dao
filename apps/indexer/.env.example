# ==============================================================================
# EQUORA.FI BLOCKCHAIN INDEXER (apps/indexer) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/equora_db?sslmode=require"

# Blockchain RPC Connection
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Indexer Parameters
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_START_BLOCK=0

# Protocol Contract Addresses (Loaded from deployedContracts or .env)
NEXT_PUBLIC_REGISTRY_ADDRESS=""
NEXT_PUBLIC_TOKEN_ADDRESS=""
NEXT_PUBLIC_NFT_ADDRESS=""
NEXT_PUBLIC_VESTING_ADDRESS=""
NEXT_PUBLIC_DAO_ADDRESS=""
NEXT_PUBLIC_MATRIX_ADDRESS=""
NEXT_PUBLIC_VAULT_ADDRESS=""
