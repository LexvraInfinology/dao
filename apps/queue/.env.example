# ==============================================================================
# EQUORA.FI QUEUE WORKER (apps/queue) — ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development

# PostgreSQL Database (used by jobs for aggregations)
DATABASE_URL="postgresql://user:password@localhost:5432/equora_db?sslmode=require"

# Redis Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Settings
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=3000
