# ==============================================================================
# EQUORA DAO (web-dao) — ENVIRONMENT CONFIGURATION TEMPLATE
# Use this file as a reference for your Vercel Project Environment Variables
# and local development (.env.local).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVE DATABASE (PostgreSQL & Neon Serverless)
# ------------------------------------------------------------------------------
POSTGRES_USER=btitan_admin
POSTGRES_PASSWORD=btitan_secret_password
POSTGRES_DB=btitan_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL="postgresql://username:password@ep-example-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. REDIS (Cache & Background Queue)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=btitan_redis_secret
REDIS_URL="redis://:btitan_redis_secret@localhost:6379"

# ------------------------------------------------------------------------------
# 2. AUTH & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="super_secret_jwt_key_min_32_characters_long"
JWT_EXPIRES_IN="24h"
SIWE_NONCE_TTL_SECONDS="300"
CORS_ORIGIN="https://equorafidao.com,https://www.equorafidao.com,https://equorafi.com,https://www.equorafi.com,http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. COMMUNITY & SOCIAL PLATFORMS
# ------------------------------------------------------------------------------
