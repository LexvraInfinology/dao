# ==============================================================================
# EQUORA DAO (web-dao) — ENVIRONMENT VARIABLES TEMPLATE FOR VERCEL & LOCAL
# ==============================================================================
# When deploying on Vercel:
# Add these variables under Project Settings -> Environment Variables.
# Frontend client-side variables must start with NEXT_PUBLIC_.
# ==============================================================================

# Core Domains & URLs
NEXT_PUBLIC_APP_URL="https://dao.equorafi.com"
NEXT_PUBLIC_API_URL="https://api.equorafi.com"
NEXT_PUBLIC_MATRIX_DOMAIN="equorafi.com"
NEXT_PUBLIC_DAO_DOMAIN="dao.equorafi.com"
NEXT_PUBLIC_MATRIX_URL="https://equorafi.com"
NEXT_PUBLIC_DAO_URL="https://dao.equorafi.com"

# Blockchain & Network (Chain ID: 31337 for local, 8812 for mainnet/testnet)
NEXT_PUBLIC_CHAIN_ID="31337"
NEXT_PUBLIC_TARGET_NETWORK="hardhat"
NEXT_PUBLIC_EXPLORER_URL="https://tronscan.org"

# Smart Contract Addresses
