NEXT_PUBLIC_WHATSAPP_DAO_GROUP_URL="https://chat.whatsapp.com/GR19373Pgq7LezBKtXC0ng"
WHATSAPP_COMMUNITY_PASSCODE="EQUORA7492"

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN RPC & FULLNODES (TrobChain Mainnet: Chain ID 1000)
