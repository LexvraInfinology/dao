# ==============================================================================
# EQUORA.FI FRONTEND (apps/web) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend REST API URL (apps/api)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Multi-Domain Configurations
NEXT_PUBLIC_MATRIX_DOMAIN="equorafi.com"
NEXT_PUBLIC_DAO_DOMAIN="equorafidao.com"
NEXT_PUBLIC_MATRIX_URL="https://equorafi.com"
NEXT_PUBLIC_DAO_URL="https://equorafidao.com"

# Web3 & Network Configuration
# Target network: "hardhat" (local), "bscTestnet" (testnet 97), or "bsc" (mainnet 56)
NEXT_PUBLIC_TARGET_NETWORK="hardhat"
NEXT_PUBLIC_CHAIN_ID="31337"
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"

# WalletConnect / Reown Project ID (https://cloud.reown.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="7663d51173c43f7ad40158edb7e88859"

# Optional: Alchemy / Infura API Key
NEXT_PUBLIC_ALCHEMY_API_KEY=""
