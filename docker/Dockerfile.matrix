# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate \
    && pnpm config set store-dir /pnpm/store
WORKDIR /workspace

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY scripts/patch-qr.js scripts/patch-qr.js
COPY apps/api/package.json apps/api/package.json
COPY apps/indexer/package.json apps/indexer/package.json
COPY apps/queue/package.json apps/queue/package.json
COPY apps/web-dao/package.json apps/web-dao/package.json
COPY apps/web-matrix/package.json apps/web-matrix/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/hardhat/package.json packages/hardhat/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/services/package.json packages/services/package.json
COPY packages/trpc/package.json packages/trpc/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/types/package.json packages/types/package.json

RUN --mount=type=cache,id=equora-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM dependencies AS builder

ARG NEXT_PUBLIC_APP_URL=https://equorafimatrix.com
ARG NEXT_PUBLIC_API_URL=https://api.equorafidao.com
ARG NEXT_PUBLIC_MATRIX_DOMAIN=equorafimatrix.com
ARG NEXT_PUBLIC_DAO_DOMAIN=equorafidao.com
ARG NEXT_PUBLIC_MATRIX_URL=https://equorafimatrix.com
ARG NEXT_PUBLIC_DAO_URL=https://equorafidao.com
ARG NEXT_PUBLIC_RPC_URL=https://fullnode-one.trobchain.com
ARG NEXT_PUBLIC_CHAIN_ID=1000
ARG NEXT_PUBLIC_TARGET_NETWORK=mainnet
ARG NEXT_PUBLIC_EXPLORER_URL=https://trobchain.com
ARG NEXT_PUBLIC_EXPLORER_API_URL=https://backend.trobchain.com/v1
ARG NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=7663d51173c43f7ad40158edb7e88859
ARG NEXT_PUBLIC_MATRIX_ADDRESS=TXdUXMtLawCBdkhDCAVCAaLEimzaiGkjz2
ARG NEXT_PUBLIC_TOKEN_ADDRESS=TS6XGpAtHma98gs8qDHdsh4BZYDEAAGjJt
ARG NEXT_PUBLIC_REGISTRY_ADDRESS=TWXbakETzfE9sBYdHTCp37HwygGKLY6AGy
ARG NEXT_PUBLIC_NFT_ADDRESS=TRhqfaRNRPeNTNoewLdamZ9W9Rz5erdHjz
ARG NEXT_PUBLIC_DAO_ADDRESS=TP7e2uoSrazAewXUgYnE6EmrtHhhSHWxPT
ARG NEXT_PUBLIC_VAULT_ADDRESS=TV6NRDubL8w749VAhsx8H8GZs8CrEcSDZB

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_MATRIX_DOMAIN=$NEXT_PUBLIC_MATRIX_DOMAIN \
    NEXT_PUBLIC_DAO_DOMAIN=$NEXT_PUBLIC_DAO_DOMAIN \
    NEXT_PUBLIC_MATRIX_URL=$NEXT_PUBLIC_MATRIX_URL \
    NEXT_PUBLIC_DAO_URL=$NEXT_PUBLIC_DAO_URL \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID \
    NEXT_PUBLIC_TARGET_NETWORK=$NEXT_PUBLIC_TARGET_NETWORK \
    NEXT_PUBLIC_EXPLORER_URL=$NEXT_PUBLIC_EXPLORER_URL \
    NEXT_PUBLIC_EXPLORER_API_URL=$NEXT_PUBLIC_EXPLORER_API_URL \
    NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID \
    NEXT_PUBLIC_MATRIX_ADDRESS=$NEXT_PUBLIC_MATRIX_ADDRESS \
    NEXT_PUBLIC_TOKEN_ADDRESS=$NEXT_PUBLIC_TOKEN_ADDRESS \
    NEXT_PUBLIC_REGISTRY_ADDRESS=$NEXT_PUBLIC_REGISTRY_ADDRESS \
    NEXT_PUBLIC_NFT_ADDRESS=$NEXT_PUBLIC_NFT_ADDRESS \
    NEXT_PUBLIC_DAO_ADDRESS=$NEXT_PUBLIC_DAO_ADDRESS \
    NEXT_PUBLIC_VAULT_ADDRESS=$NEXT_PUBLIC_VAULT_ADDRESS \
    NEXT_TELEMETRY_DISABLED=1

COPY . .
RUN pnpm --filter @equora/web-matrix build
RUN CI=true pnpm install --prod --filter=@equora/web-matrix --frozen-lockfile --ignore-scripts
RUN set -eux; \
    rm -rf /out; \
    mkdir -p /out/apps/web-matrix; \
    cp package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc /out/; \
    cp apps/web-matrix/package.json /out/apps/web-matrix/package.json; \
    cp -R apps/web-matrix/.next /out/apps/web-matrix/.next; \
    cp -R apps/web-matrix/public /out/apps/web-matrix/public; \
    cp apps/web-matrix/next.config.ts /out/apps/web-matrix/next.config.ts

FROM base AS production-dependencies

WORKDIR /app

COPY --from=builder /out/ ./
RUN --mount=type=cache,id=equora-pnpm-store,target=/pnpm/store \
    CI=true pnpm install --prod --filter=@equora/web-matrix --frozen-lockfile --ignore-scripts

FROM base AS runtime

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --from=production-dependencies /app/ ./

USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/dashboard').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

WORKDIR /app/apps/web-matrix
CMD ["npx", "next", "start", "-p", "3001"]
