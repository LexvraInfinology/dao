# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate \
    && pnpm config set store-dir /pnpm/store
WORKDIR /workspace

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY scripts/patch-qr.js scripts/patch-qr.js
COPY apps/web-matrix/package.json apps/web-matrix/package.json

RUN --mount=type=cache,id=equora-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM dependencies AS builder

ARG NEXT_PUBLIC_APP_URL=https://equorafimatrix.com
ARG NEXT_PUBLIC_API_URL=https://api.equorafidao.com/api/matrix
ARG NEXT_PUBLIC_RPC_URL=https://fullnode-one.trobchain.com
ARG NEXT_PUBLIC_MATRIX_ADDRESS=TXdUXMtLawCBdkhDCAVCAaLEimzaiGkjz2

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_MATRIX_ADDRESS=$NEXT_PUBLIC_MATRIX_ADDRESS \
    NEXT_TELEMETRY_DISABLED=1

COPY . .
RUN pnpm --filter @equora/web-matrix build

FROM base AS runtime

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --from=builder /workspace/apps/web-matrix/.next /app/apps/web-matrix/.next
COPY --from=builder /workspace/apps/web-matrix/public /app/apps/web-matrix/public
COPY --from=builder /workspace/apps/web-matrix/package.json /app/apps/web-matrix/package.json
COPY --from=builder /workspace/apps/web-matrix/next.config.ts /app/apps/web-matrix/next.config.ts
COPY --from=builder /workspace/node_modules /app/node_modules
COPY --from=builder /workspace/apps/web-matrix/node_modules /app/apps/web-matrix/node_modules

USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/dashboard').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

WORKDIR /app/apps/web-matrix
CMD ["npx", "next", "start", "-p", "3001"]
