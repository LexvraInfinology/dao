{
  "name": "equora-fi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@btitan/hardhat",
    "dev:web": "pnpm --filter @equora/web dev",
    "dev:api": "pnpm --filter @btitan/api dev",
    "dev:indexer": "pnpm --filter @btitan/indexer dev",
    "dev:queue": "pnpm --filter @btitan/queue dev",
    "chain": "pnpm --filter @btitan/hardhat chain",
    "compile": "pnpm --filter @btitan/hardhat compile",
    "deploy": "pnpm --filter @btitan/hardhat deploy",
    "deploy:testnet": "pnpm --filter @btitan/hardhat deploy:testnet",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @btitan/database db:generate",
    "db:push": "pnpm --filter @btitan/database db:push",
    "db:migrate": "pnpm --filter @btitan/database db:migrate",
    "db:studio": "pnpm --filter @btitan/database db:studio",
    "clean": "turbo run clean",
    "postinstall": "node scripts/patch-qr.js"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
