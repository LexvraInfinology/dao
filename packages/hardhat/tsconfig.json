{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "./hardhat.config.ts",
    "./contracts",
    "./test",
    "./scripts",
    "./typechain-types"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "cache"]
}
